# Postgres
POSTGRES_USER=cloudy
POSTGRES_PASSWORD=cloudy
POSTGRES_DB=cloudy_plag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=cloudy
MINIO_ROOT_PASSWORD=cloudy-dev-secret
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=cloudy-plag-documents
MINIO_USE_SSL=false

# Backend
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
